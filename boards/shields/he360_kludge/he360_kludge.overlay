#include <zephyr/dt-bindings/ieee802154/ieee802154_adf702x.h>

/ {
	chosen {
		led0 = &led0;

		nsp,rx = &ttc_downlink;
		nsp,tx = &ttc_uplink;

		nsp,uart = &cdcacm;
	};
};

&zephyr_udc0 {
	cdcacm: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&led0 {
	gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
};

&pico_spi {
	status = "okay";
	cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>,
		   <&gpio0 26 GPIO_ACTIVE_LOW>;

	ttc_downlink: adf7024_rx_800: downlink-895@0 {
		status = "okay";
		compatible = "adi,adf702x";
		reg = <0>;
		spi-max-frequency = <1000000>;

		channel-frequency = <895000000>;

		irq-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
	};

	ttc_uplink: adf7024_tx_400: uplink-434@1 {
		status = "okay";
		compatible = "adi,adf702x";
		reg = <1>;
		spi-max-frequency = <1000000>;

		channel-frequency = <(434000000)>;
		adf7024,radio-profile = <RADIO_PROFILE_B>;

		adf702x,pa-level = "-5";

		irq-gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
	};
};
