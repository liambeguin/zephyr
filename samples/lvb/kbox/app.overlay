/ {
	chosen {
		zephyr,ieee802154 = &adf7024_tx;
		zephyr,ieee802154_tx = &adf7024_tx;
		zephyr,ieee802154_rx = &adf7024_rx;
	};
};

&pinctrl {
	i2c0_default: i2c0_default {
		group1 {
			pinmux = <I2C0_SDA_P8>, <I2C0_SCL_P9>;
			input-enable;
			input-schmitt-enable;
		};
	};
};

&pico_i2c0 {
	tca9555@27 {
		compatible = "nxp,pca95xx";
		reg = <0x27>;
		gpio-controller;
		#gpio-cells = <2>;
	};
};

&pico_spi {
	status = "okay";
	cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>,
		   <&gpio0 05 GPIO_ACTIVE_LOW>;

	/* ADF7024DB1Z_nCS RX */
	adf7024_tx: ieee802144@0 {
		status = "okay";
		compatible = "adi,adf702x";
		reg = <0>;
		spi-max-frequency = <1000000>;

		channel-frequency = <869100000>;

		irq-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
	};

	/* ADF7024DB3Z_nCS TX */
	adf7024_rx: ieee802144@1 {
		status = "okay";
		compatible = "adi,adf702x";
		reg = <1>;
		spi-max-frequency = <1000000>;

		channel-frequency = <432100000>;

		irq-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
	};
};
