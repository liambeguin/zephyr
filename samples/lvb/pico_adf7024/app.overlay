#include <zephyr/dt-bindings/ieee802154/ieee802154_adf702x.h>

// #define TTC_MODE 1
/ {
	chosen {
		led0 = &led0;

#ifdef TTC_MODE
		zephyr,ieee802154_tx_ttc = &adf7024_tx_400;
#else
		zephyr,ieee802154_tx = &adf7024_tx_800;
		zephyr,ieee802154_rx = &adf7024_rx_800;
#endif
	};
};

&led0 {
	gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
};

&pico_spi {
	status = "okay";
	cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>,
		   <&gpio0 22 GPIO_ACTIVE_LOW>,
		   <&gpio0 26 GPIO_ACTIVE_LOW>;

#if TTC_MODE
	adf7024_tx_400: ieee802154@0 {
		status = "okay";
		compatible = "adi,adf702x";
		reg = <0>;
		spi-max-frequency = <1000000>;

		channel-frequency = <432100000>;
		adf7024,radio-profile = <RADIO_PROFILE_B>;

		irq-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
	};

#else
	adf7024_rx_800: ieee802154@1 {
		status = "okay";
		compatible = "adi,adf702x";
		reg = <1>;
		spi-max-frequency = <1000000>;

		channel-frequency = <869100000>;

		irq-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
	};

	adf7024_tx_800: ieee802154@2 {
		status = "okay";
		compatible = "adi,adf702x";
		reg = <2>;
		spi-max-frequency = <1000000>;

		channel-frequency = <869100000>;

		irq-gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
	};
#endif
};
