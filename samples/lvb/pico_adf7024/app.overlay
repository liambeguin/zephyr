/ {
	chosen {
		led0 = &led0;

		zephyr,ieee802154 = &adf7024_tx_800;
		zephyr,ieee802154_tx = &adf7024_tx_800;
		zephyr,ieee802154_rx = &adf7024_rx_800;
	};
};

&led0 {
	gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
};

&pico_spi {
	status = "okay";
	cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>,
		   <&gpio0 22 GPIO_ACTIVE_LOW>,
		   <&gpio0 26 GPIO_ACTIVE_LOW>;

	adf7024_tx_400: ieee802144@0 {
		status = "okay";
		compatible = "adi,adf702x";
		reg = <0>;
		spi-max-frequency = <1000000>;

		channel-frequency = <869100000>;

		irq-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
	};

	adf7024_rx_800: ieee802144@1 {
		status = "okay";
		compatible = "adi,adf702x";
		reg = <1>;
		spi-max-frequency = <1000000>;

		channel-frequency = <869100000>;

		irq-gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
	};

	adf7024_tx_800: ieee802144@2 {
		status = "okay";
		compatible = "adi,adf702x";
		reg = <2>;
		spi-max-frequency = <1000000>;

		channel-frequency = <869100000>;

		irq-gpios = <&gpio0 27 GPIO_ACTIVE_HIGH>;
	};
};
